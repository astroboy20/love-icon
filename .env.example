# ============================================================
# LoveCoin Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# ---- Client-side variables (exposed to the browser via Vite) ----

# Your Supabase project URL (found in Project Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase publishable (anon) key (found in Project Settings → API)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ---- Server-side variables (never exposed to the browser) ----

# Bachs payment gateway API key (from your Bachs dashboard)
BACHS_API_KEY=bachs_live_your_api_key_here

# Bachs webhook signing secret — used to verify HMAC-SHA256 webhook signatures
BACHS_WEBHOOK_SECRET=bachs_whsec_your_webhook_secret_here

# Supabase service role key — has full database access, keep this secret
# (found in Project Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# URL to redirect users to after a successful Bachs payment
BACHS_RETURN_URL=https://your-domain.com/payment/success

# URL to redirect users to after a cancelled Bachs payment
BACHS_CANCEL_URL=https://your-domain.com/payment/cancel

# Base URL for the Bachs API (default: https://api.bachs.co)
BACHS_BASE_URL=https://api.bachs.co
